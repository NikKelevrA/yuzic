require 'dotenv'
Dotenv.load

default_platform(:android)

# Version codes and build numbers are asked of the stores, never derived.
#
# They used to be GITHUB_RUN_NUMBER plus a fixed offset, documented as "a
# per-workflow-file counter that never resets or repeats". That is true of a
# workflow_dispatch and false of a workflow_call: a reusable workflow sees the
# *caller's* run number, so one build entered two ways kept two unrelated
# counters. The dispatch path reached versionCode 132 while the release path
# was still at 118, and Play refused 2.0.0 with "You cannot rollout this
# release because it does not allow any existing users to upgrade to the newly
# added APKs" — after a fully green Gradle build.
#
# Play and App Store Connect both require a number greater than what they
# already hold, which makes them the only things that know the answer. Asking
# them makes every entry point agree by construction. There is deliberately no
# override and no fallback: a number nobody checked is the failure being
# replaced here, and version code space spent is not recoverable.

APP_IDENTIFIER = "com.arinora.rawarr"

# Every track, not only the one being uploaded to. A code live anywhere is a
# code Play will not take again, and production sits below alpha here.
PLAY_TRACKS = %w[internal alpha beta production].freeze

def resolved_android_version_code
  codes = PLAY_TRACKS.flat_map do |track|
    begin
      google_play_track_version_codes(
        package_name: APP_IDENTIFIER,
        track: track,
        json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"]
      ).map(&:to_i)
    rescue StandardError => e
      # A track that has never been used has nothing to report, which is not
      # a failure — only every track being unreadable is.
      UI.important("No version codes readable on '#{track}' (#{e.message.to_s.strip.lines.first.to_s.strip}) — skipping it.")
      []
    end
  end

  if codes.empty?
    UI.user_error!(
      "Play returned no version codes on any of: #{PLAY_TRACKS.join(', ')}. " \
      "Refusing to invent one. Check GOOGLE_PLAY_JSON_KEY and that the package " \
      "is still #{APP_IDENTIFIER}."
    )
  end

  highest = codes.max
  code = highest + 1
  UI.important("Highest version code on Play: #{highest}. Using Android version code: #{code}")
  code
end

def resolved_version_label
  raw = ENV["VERSION_LABEL"]&.strip
  value = raw.nil? || raw.empty? ? "1.1.17" : raw

  unless value.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("Invalid version label '#{value}'. Use semantic format like 1.1.17.")
  end

  UI.important("Using version label: #{value}")
  value
end

def resolved_ios_build_number(api_key, _version_label)
  # Every build the app has, and the highest number among them — not the
  # "latest" one.
  #
  # `latest_testflight_build_number` cannot answer this, and using it here was
  # a real mistake rather than a subtlety: it asks App Store Connect for
  # `sort: "-uploadedDate", limit: 1`, so it returns the most recently
  # *uploaded* build. When 2.0.0 (10) was uploaded after 2.0.0 (94), "latest"
  # was 10, this produced 11, and the new build sorted below five older ones in
  # TestFlight. The two-counter bug was fixed and the number still did not
  # climb.
  #
  # Asked across every version rather than the current train. App Store Connect
  # only requires uniqueness within a train, but a number that also climbs
  # app-wide is what puts a new build at the top of the tester's list, which is
  # the thing anyone actually wants from it.
  require 'spaceship'

  token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  UI.user_error!("No App Store Connect API token — cannot ask for a build number.") if token.nil?
  Spaceship::ConnectAPI.token = token

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No app on App Store Connect for #{APP_IDENTIFIER}.") if app.nil?

  # AWAITING_UPLOAD is excluded because those carry no uploaded date and are
  # not builds anyone has; the other three states all hold a number that is
  # spent and cannot be reused.
  uploads = Spaceship::ConnectAPI.get_build_uploads(
    app_id: app.id,
    filter: { state: "PROCESSING,FAILED,COMPLETE" },
    sort: "-uploadedDate",
    limit: 200
  )

  numbers = uploads.map { |upload| upload.cf_build_version.to_i }.reject(&:zero?)
  if numbers.empty?
    UI.user_error!(
      "App Store Connect returned no builds for #{APP_IDENTIFIER}. Refusing to " \
      "invent a build number — check the API key's access."
    )
  end

  highest = numbers.max
  value = highest + 1
  UI.important(
    "App Store Connect holds #{numbers.count} builds (capped at 200 by recency); " \
    "highest build number: #{highest}. Using iOS build number: #{value}"
  )
  value
end

def resolved_ios_team_id
  ENV["IOS_TEAM_ID"] || "Y6YJ4P25H9"
end

def resolved_ios_profile_name
  raw = ENV["IOS_PROFILE_NAME"]&.strip
  raw.nil? || raw.empty? ? "carplay" : raw
end

# The states in which App Store Connect will let a version's screenshots be
# replaced. Everything else — submitted, in review, accepted, awaiting release,
# live — refuses the delete.
#
# An allowlist rather than a denylist on purpose: a state nobody here has seen
# yet should leave the listing alone, not gamble a release on it.
SCREENSHOT_EDITABLE_STATES = [
  "PREPARE_FOR_SUBMISSION",
  "DEVELOPER_REJECTED",
  "REJECTED",
  "METADATA_REJECTED",
  "INVALID_BINARY"
].freeze

def screenshots_replaceable?(api_key)
  # Apple will not let a submitted version's screenshots be replaced, and
  # `deliver` asks anyway.
  #
  # It picks its target with `get_edit_app_store_version`, whose filter counts
  # WAITING_FOR_REVIEW as editable. Apple disagrees. Deleting a screenshot on a
  # submitted version returns:
  #
  #   The request cannot be fulfilled because of the state of another resource.
  #   - Can't Delete Screenshot After Submit for review appScreenshots
  #
  # and because `overwrite_screenshots` deletes before it uploads, the upload
  # dies right there. It is a state lock, not a transient, so deliver's five
  # retries only repeat the same rejection — which is the whole content of
  # "Failed verification of all screenshots deleted... 10 screenshot(s) still
  # exist", the message that killed two builds on 2026-09-19. Both were dev
  # builds carrying version label 2.6.3 while 2.6.3 sat in review.
  #
  # So the question is asked once, up front, and the answer is a property of
  # the version rather than of the attempt.
  require 'spaceship'

  token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  if token.nil?
    UI.important("No App Store Connect token — leaving the listing alone.")
    return false
  end
  Spaceship::ConnectAPI.token = token

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  if app.nil?
    UI.important("No app on App Store Connect for #{APP_IDENTIFIER} — leaving the listing alone.")
    return false
  end

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  if version.nil?
    UI.important("No editable App Store version — leaving the listing alone.")
    return false
  end

  # Order matters, and not arbitrarily: `app_store_state` is marked deprecated
  # in App Store Connect API specification 3.3, so it is the one liable to come
  # back nil against a current API version. `app_version_state` is the current
  # field and has to be read first. Do not flip this.
  #
  # The five states above happen to be spelled identically in both enums, so
  # the check is safe whichever field answers. That is luck rather than design
  # — the vocabularies diverge elsewhere (AppStoreState has READY_FOR_SALE,
  # AppVersionState has READY_FOR_DISTRIBUTION instead), so anything added to
  # the list has to be checked against both.
  state = version.app_version_state || version.app_store_state
  unless SCREENSHOT_EDITABLE_STATES.include?(state)
    UI.important(
      "Version #{version.version_string} is #{state}. App Store Connect will " \
      "not replace the screenshots of a version in that state, so they are " \
      "being left alone. This is not a build failure."
    )
    return false
  end

  UI.important("Version #{version.version_string} is #{state}; screenshots can be replaced.")
  true
rescue => error
  # Asking must never be more dangerous than not asking.
  UI.important("Could not read the App Store version state (#{error.message}) — leaving the listing alone.")
  false
end

def prepare_build_dirs
  sh "mkdir -p build/android"
  sh "mkdir -p build/ios"
end

platform :android do
  desc "Build Android and upload to Play Closed Testing"
  lane :ci_android do
    prepare_build_dirs

    gradle(
      tasks: ["clean", "assembleRelease", "bundleRelease"],
      project_dir: "android",
      flags: "--no-daemon",
      properties: {
        "android.injected.version.code" => resolved_android_version_code,
        "android.injected.version.name" => resolved_version_label
      }
    )

    supply(
      track: "alpha",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      # Screenshots only. `skip_upload_images` is a SEPARATE flag covering the
      # icon, feature graphic, promo graphic and TV banner — not screenshots.
      # Enabling it made supply upload `images/icon.png`, which Play refused
      # for being 4167x4167 against a required 512x512, and a refused image
      # aborts the WHOLE edit: the AAB and the track update went with it, so
      # 2.2.0 never reached alpha after a 24-minute Gradle build. Play already
      # has the right icon; it is not ours to re-upload from here.
      skip_upload_images: true,
      skip_upload_screenshots: false,
      # Explicitly not skipped. Notes come from
      # metadata/android/en-US/changelogs/default.txt, which supply falls back
      # to when there is no <version code>.txt — and there cannot be one, since
      # the code is only known once Play has been asked. Every upload before
      # this logged "Could not find changelog" and shipped with no notes.
      skip_upload_changelogs: false
    )
  end
end

platform :ios do
  desc "Build iOS and upload to App Store Connect"
  lane :ci_ios do
    prepare_build_dirs

    team_id = resolved_ios_team_id
    version_label = resolved_version_label
    profile_name = resolved_ios_profile_name

    UI.important("iOS team id: #{team_id}")
    UI.important("iOS version label: #{version_label}")
    UI.important("iOS provisioning profile: #{profile_name}")

    setup_ci(
      keychain_name: "build.keychain",
      timeout: 21600
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_KEY_BASE64"],
      is_key_content_base64: true
    )

    # After the API key exists, because the number is asked of App Store
    # Connect rather than derived from anything local.
    build_number = resolved_ios_build_number(api_key, version_label)

    match(
      type: "appstore",
      app_identifier: "com.arinora.rawarr",
      team_id: team_id,
      api_key: api_key,
      readonly: true,
      keychain_name: "build.keychain"
    )

    increment_version_number(
      version_number: version_label,
      xcodeproj: "ios/Yuzic.xcodeproj"
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Yuzic.xcodeproj"
    )

    build_app(
      scheme: "Yuzic",
      workspace: "ios/Yuzic.xcworkspace",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version_label}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.arinora.rawarr" => profile_name
        }
      },
      output_directory: "build/ios",
      output_name: "Yuzic.ipa",
      include_symbols: false,
      include_bitcode: false
    )

    # The binary first, and on its own.
    #
    # These used to be one `upload_to_app_store` call doing both, screenshots
    # first — so anything the store disliked about an image discarded a fully
    # archived build. That is how 2.2.0 died on both platforms after a
    # 24-minute Gradle build and a successful Xcode archive, and how two
    # dispatched builds died on 2026-09-19 when App Store Connect would not
    # confirm a screenshot deletion it had been asked for.
    #
    # Every fix before this one addressed the *particular* thing the store
    # objected to: the oversized icon, the interactive prompt, the duplicate
    # uploads. The coupling survived each time and found a new way to spend a
    # build. So the binary now goes first and by itself, and nothing about the
    # listing can cost it.
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/Yuzic.ipa",
      # The build is uploaded; what Apple then does with it takes minutes and
      # nothing here waits on the answer. `false` here is what made the old
      # call sit through processing before it would move on.
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # Then the listing, which may fail without taking the build with it.
    #
    # `skip_binary_upload` is the load-bearing part: this call must not be a
    # second route to uploading the app.
    #
    # CI always sets `YUZIC_UPLOAD_SCREENSHOTS`, since a release is the only
    # thing that runs this lane there now. What the guard still catches is a
    # `fastlane ci_ios` from a laptop, where an unset variable reads as false
    # and the public listing is left alone — which is the right default for a
    # run nobody can trace back to a version.
    unless ENV["YUZIC_UPLOAD_SCREENSHOTS"] == "true"
      UI.important("Skipping store screenshots: not a release build.")
      next
    end

    # And only when Apple will actually accept them. Checked before the upload
    # rather than discovered during it.
    next unless screenshots_replaceable?(api_key)

    begin
      upload_to_app_store(
        api_key: api_key,
        skip_binary_upload: true,
        skip_metadata: true,
        # Screenshots come from tools/store-screenshots (capture.sh, then
        # publish.py) and land in fastlane/screenshots/en-US. deliver picks the
        # device from the filename prefix, so those names are load-bearing.
        #
        # App Store Connect accepts only exact sizes and rejects the upload
        # otherwise. compose.py exports at the store size for that reason (the
        # iPad artboard is 2064x2752 while the store wants 2048x2732), and
        # publish.py asserts it before copying.
        skip_screenshots: false,
        overwrite_screenshots: true,
        # deliver renders a Preview.html and asks "Does the Preview ... look
        # okay for you?" whenever it uploads screenshots. On a runner nobody
        # can answer and it does NOT fall back to a default — it raises
        # FastlaneCrash before returning, so this is what makes screenshot
        # upload survivable at all.
        force: true,
        submit_for_review: false,
        run_precheck_before_submit: false
      )
    rescue => error
      # Loud, and not fatal. The build is already on TestFlight by here, and a
      # listing that is one release out of date is a smaller problem than a
      # release that did not ship.
      #
      # `screenshots_replaceable?` already turns away the known cause — a
      # version that has been submitted — so reaching here means something
      # else. The version's state on App Store Connect is still the first
      # thing to read; re-running is still not a fix.
      UI.error("Store screenshots were not updated: #{error.message}")
      UI.error("The build shipped. Check the version's state on App Store Connect.")
    end
  end
end
